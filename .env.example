# Copy this file to .env and fill in real values. Never commit .env to version control.

# PostgreSQL
POSTGRES_DB=usersdb
POSTGRES_USER=usersdb_user
POSTGRES_PASSWORD=your_strong_password_here

# Application datasource (matches docker-compose service name)
DB_URL=jdbc:postgresql://db:5432/usersdb
DB_USERNAME=usersdb_user
DB_PASSWORD=your_strong_password_here

# Admin credentials for write endpoints (HTTP Basic Auth)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_admin_password_here
